# Скопируйте в .env и измените значения перед запуском в общей сети.

# Порт, на котором ОРБИТА будет доступна на хосте: http://localhost:8080
APP_PORT=8080

# PostgreSQL (пароль без символов @ : / ? # — он подставляется в DATABASE_URL)
POSTGRES_DB=orbita
POSTGRES_USER=orbita
POSTGRES_PASSWORD=orbita-db-secret

# Пароль учётной записи admin, создаётся при первом запуске на пустой БД
ADMIN_PASSWORD=admin2026
# Создать демонстрационных пользователей operator / observer
SEED_DEMO_USERS=true
# Показывать демо-логины на странице входа
DEMO_MODE=true

# За HTTPS-прокси: COOKIE_SECURE=true и TRUST_PROXY=true
COOKIE_SECURE=false
TRUST_PROXY=false

# Симуляция полёта: случайные отказы на один КА в час (0 — выключить)
SIMULATION=true
ANOMALY_RATE_PER_HOUR=0.12
LOG_LEVEL=info
